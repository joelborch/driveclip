{
  "manifest_version": 3,
  "key": "",
  "name": "DriveClip",
  "version": "0.1.0",
  "description": "Record a tab or your desktop with mic narration and stream it straight into your Google Drive.",
  "permissions": [
    "offscreen",
    "tabCapture",
    "desktopCapture",
    "identity",
    "storage",
    "activeTab",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://www.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "DriveClip",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "oauth2": {
    "client_id": "439781044669-rc3mov24beo1k016s8heagr36ghki0ph.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/drive.file"
    ]
  }
}
